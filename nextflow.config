// Hash inputs and bin/ scripts by content. The default (path + size + mtime) puts the
// absolute path of bin/*.py in every task hash, so moving the project reruns everything.
process.cache = 'deep'

// Wave container built from envs/icechunk.yml (linux/amd64, frozen).
process.container = 'community.wave.seqera.io/library/icechunk:02b6b7323726df2f'

docker {
    enabled    = true
    runOptions = "-v ${projectDir}/icechunk_stores:${projectDir}/icechunk_stores"
}

// scatter.nf: a killed tile (exit 137, e.g. OOM or preemption) is retried by Nextflow.
process {
    withName: 'TILE' {
        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'terminate' }
        maxRetries = 2
    }
}
